                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="modal-footer border-0 bg-light py-3">
                    <button type="button" class="btn btn-secondary px-4" v-on:click="chiudiDettagliNave">Chiudi scheda</button>
                </div>
            </div>
        </div>
    </div>

</div>

