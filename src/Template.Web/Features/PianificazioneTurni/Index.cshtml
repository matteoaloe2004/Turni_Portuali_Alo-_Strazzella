                                 </span>
                            </div>
                            <div class="gantt-block-sub font-monospace" style="font-size: 0.62rem; opacity: 0.9;">
                                <i class="fa-solid fa-anchor me-1"></i>{{ t.banchina }}
                            </div>
                        </div>

