                                 left: blockLeft(t), 
                                 width: blockWidth(t),
                                 opacity: isElementoFiltrato(t) ? 1 : 0.15,
                                 filter: isElementoFiltrato(t) ? 'none' : 'grayscale(60%)',
                                 height: '38px',
                                 top: '14px'
                             }"
                             v-on:click.stop="handleBlockClick(t)"
                             v-bind:title="t.isDelayed ? 'Nave in ritardo – clicca per risolvere' : (isBloccoInCollisione(t) && !t.isDelayed ? 'Dettagli nave ' + t.nome + ' (Bloccata per modifiche)' : 'Dettagli nave ' + t.nome)">
