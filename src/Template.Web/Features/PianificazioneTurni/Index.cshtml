@model Template.Web.Features.PianificazioneTurni.IndexViewModel
@{
    ViewData["Title"] = "Console di pianificazione turni portuali";
}

@* Scheletro della pagina: una partial per ogni sezione. *@

@section styles {
    <link rel="stylesheet" href="~/css/pianificazione-turni.css" asp-append-version="true" />
}

<div id="app-turni" class="container-fluid py-2 px-4" v-cloak>

    <script type="application/json" id="Seed_JSON">@Html.Raw(Model.ToJson())</script>

    @* Conferme ed errori passano di qui oltre che dal toast, che è solo visivo. *@
    <div id="annunci-live" class="visually-hidden" aria-live="polite" aria-atomic="true"></div>

    <partial name="~/Features/PianificazioneTurni/_BarraStato.cshtml" />
    <partial name="~/Features/PianificazioneTurni/_TurnoDaRisolvere.cshtml" />

    <ul class="nav nav-tabs mb-3 border-0 border-bottom gap-2" role="tablist"
        v-on:keydown.left.prevent="tabPrecedente()"
        v-on:keydown.right.prevent="tabSuccessivo()">
        <li class="nav-item" role="presentation">
            <button type="button" id="tab-pianificazione" role="tab"
                    class="nav-link border-0 border-bottom border-3 fw-bold px-3 py-2"
                    v-bind:class="{ active: activeTab === 'pianificazione' }"
                    v-bind:aria-selected="activeTab === 'pianificazione' ? 'true' : 'false'"
                    v-bind:tabindex="activeTab === 'pianificazione' ? 0 : -1"
                    aria-controls="pannello-pianificazione"
                    v-on:click="setActiveTab('pianificazione')">
                <i class="fa-solid fa-desktop me-1" aria-hidden="true"></i>Pianificazione
            </button>
        </li>
        @* asp-roles non emette il markup lato server: senza il ruolo, la scheda non esiste. *@
        <li class="nav-item" role="presentation" asp-roles="Admin">
            <button type="button" id="tab-simulazioni" role="tab"
                    class="nav-link border-0 border-bottom border-3 fw-bold px-3 py-2"
                    v-bind:class="{ active: activeTab === 'simulazioni' }"
                    v-bind:aria-selected="activeTab === 'simulazioni' ? 'true' : 'false'"
                    v-bind:tabindex="activeTab === 'simulazioni' ? 0 : -1"
                    aria-controls="pannello-simulazioni"
                    v-on:click="setActiveTab('simulazioni')">
                <i class="fa-solid fa-sliders me-1" aria-hidden="true"></i>Simulazioni ed emergenze
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button type="button" id="tab-eventi" role="tab"
                    class="nav-link border-0 border-bottom border-3 fw-bold px-3 py-2"
                    v-bind:class="{ active: activeTab === 'eventi' }"
                    v-bind:aria-selected="activeTab === 'eventi' ? 'true' : 'false'"
                    v-bind:tabindex="activeTab === 'eventi' ? 0 : -1"
                    aria-controls="pannello-eventi"
                    v-on:click="setActiveTab('eventi')">
                <i class="fa-solid fa-list-ul me-1" aria-hidden="true"></i>Registro comunicazioni
                <span v-if="notificheSimulate.length > 0" class="badge bg-secondary ms-1 rounded-pill">
                    {{ notificheSimulate.length }}
                    <span class="visually-hidden">comunicazioni registrate</span>
                </span>
            </button>
        </li>
    </ul>

    <div class="tab-content-vue flex-grow-1">
        <div id="pannello-pianificazione" role="tabpanel" aria-labelledby="tab-pianificazione"
             v-show="activeTab === 'pianificazione'" class="tab-panel-flex">
            <partial name="~/Features/PianificazioneTurni/_TabPianificazione.cshtml" />
        </div>

        <div id="pannello-simulazioni" role="tabpanel" aria-labelledby="tab-simulazioni"
             v-show="activeTab === 'simulazioni'" class="w-100" asp-roles="Admin">
            <partial name="~/Features/PianificazioneTurni/_TabSimulazioni.cshtml" />
        </div>

        <div id="pannello-eventi" role="tabpanel" aria-labelledby="tab-eventi"
             v-show="activeTab === 'eventi'" class="w-100">
            <partial name="~/Features/PianificazioneTurni/_TabRegistro.cshtml" />
        </div>
    </div>

    <partial name="~/Features/PianificazioneTurni/_ModaleConflitto.cshtml" />
    <partial name="~/Features/PianificazioneTurni/_ModaleOperatore.cshtml" />
    <partial name="~/Features/PianificazioneTurni/_ModaleNave.cshtml" />

    @* Il SignalRConnectionManager cerca questi due blocchi per id: non vanno rinominati. *@
    <div id="lostConnection" class="avviso-connessione d-none p-3 mt-3 d-flex align-items-center gap-3" role="status">
        <i class="fa-solid fa-arrows-rotate fa-spin fs-4" aria-hidden="true"></i>
        <div>
            <strong>Ho perso il collegamento con gli altri coordinatori.</strong>
            Sto riprovando: intanto continua pure, le modifiche passano comunque dal server.
        </div>
    </div>

    <div id="lostConnectionManualRetry" class="avviso-connessione d-none p-3 mt-3 d-flex align-items-center gap-3" role="alert">
        <i class="fa-solid fa-plug-circle-exclamation fs-4" aria-hidden="true"></i>
        <div class="flex-grow-1">
            <strong>Non riesco a ricollegarmi.</strong>
            Da qui in avanti non vedrai le modifiche fatte dagli altri coordinatori finché non ricarichi la pagina.
        </div>
        <button type="button" class="btn btn-outline-secondary btn-sm fw-semibold flex-shrink-0"
                onclick="location.reload()">
            <i class="fa-solid fa-rotate me-1" aria-hidden="true"></i>Ricarica
        </button>
    </div>
</div>

@section scripts {
    <script src="/js/bundle-vue.js" asp-append-version="true"></script>

    <script src="~/node_modules/@@microsoft/signalr/dist/browser/signalr.js" asp-append-version="true"></script>
    <script src="~/js/signalRConnectionManager.js" asp-append-version="true"></script>

    @* Index.Regole.js per primo: definisce costanti e funzioni che gli altri usano. *@
    <script src="~/js/Features/PianificazioneTurni/Index.Regole.js" asp-append-version="true"></script>
    <script src="~/js/Features/PianificazioneTurni/Index.js" asp-append-version="true"></script>
    <script src="~/js/Features/PianificazioneTurni/Index.Gantt.js" asp-append-version="true"></script>
    <script src="~/js/Features/PianificazioneTurni/Index.Assegnazione.js" asp-append-version="true"></script>
    <script src="~/js/Features/PianificazioneTurni/Index.Modali.js" asp-append-version="true"></script>
    <script src="~/js/Features/PianificazioneTurni/Index.Notifiche.js" asp-append-version="true"></script>
    <script src="~/js/Features/PianificazioneTurni/Index.Collaborazione.js" asp-append-version="true"></script>

    <script type="text/javascript">
        (function () {
            var modello = new PianificazioneTurni.IndexVueModel();
            var prototipo = PianificazioneTurni.IndexVueModel.prototype;

            // Vue 2 vede solo le proprietà proprie dell'oggetto passato come `data`:
            // i metodi stanno sul prototype, quindi vanno inoltrati a mano.
            var metodi = {};
            var derivate = {};

            Object.getOwnPropertyNames(prototipo).forEach(function (nome) {
                if (nome === 'constructor') return;
                var descrittore = Object.getOwnPropertyDescriptor(prototipo, nome);

                if (typeof descrittore.value === 'function') {
                    metodi[nome] = function () {
                        return modello[nome].apply(modello, arguments);
                    };
                } else if (typeof descrittore.get === 'function') {
                    // I getter leggono proprietà reattive: come computed si ricalcolano da soli.
                    derivate[nome] = function () { return modello[nome]; };
                }
            });

            new Vue({
                el: '#app-turni',
                data: modello,
                mounted: function () {
                    modello.inizializzaStato();
                },
                methods: metodi,
                computed: Object.assign(derivate, {
                    // La lista di soluzioni può accorciarsi dopo la scelta: questi due
                    // tengono l'indice dentro i limiti.
                    indiceDSSCorrente: function () {
                        var i = this.soluzioneDSSSelezionataIndex;
                        if (i === null || i < 0 || i >= this.soluzioniDSSTask.length) return 0;
                        return i;
                    },
                    soluzioneDSSCorrente: function () {
                        var lista = this.soluzioniDSSTask;
                        return lista && lista.length > 0 ? (lista[this.indiceDSSCorrente] || null) : null;
                    },
                    tasksDaAssegnareGiorno: function () {
                        var giorno = Number(this.giornoSelezionato);
                        return (this.tasksDaAssegnare || []).filter(function (t) {
                            return Number(t.giorno) === giorno;
                        });
                    }
                })
            });
        })();
    </script>
}
