@* Lavorazioni da assegnare e, sotto, le alternative proposte dal DSS. *@

<section class="card border-0 shadow-sm d-flex flex-column h-100" aria-labelledby="titolo-backlog">
    <div class="card-header border-bottom py-3 px-3 d-flex align-items-center justify-content-between">
        <h2 id="titolo-backlog" class="h6 mb-0 fw-bold text-dark">
            <i class="fa-solid fa-list-check text-primary me-2" aria-hidden="true"></i>Lavorazioni da assegnare
        </h2>
        <span v-if="tasksDaAssegnareGiorno.length > 0" class="badge bg-primary">
            {{ tasksDaAssegnareGiorno.length }} in attesa
        </span>
    </div>

    <div class="card-body p-3 d-flex flex-column">
        <p v-if="tasksDaAssegnareGiorno.length === 0" class="text-muted text-center py-4 mb-0">
            <i class="fa-solid fa-circle-check d-block mb-2 text-success fs-4" aria-hidden="true"></i>
            Nessuna lavorazione in attesa per questo giorno.
        </p>

        @* Griglia e non colonna: a piena larghezza due lavorazioni stanno affiancate,
           e il tabellone sale di una card. *@
        <div v-else class="row g-3">
            <div v-for="task in tasksDaAssegnareGiorno" :key="task.id" class="col-lg-6 col-12">
            @* Bottone e non div: la selezione deve funzionare anche da tastiera. *@
            <button type="button"
                    class="backlog-card p-3 border-0 w-100 h-100"
                    v-bind:aria-pressed="selectedTask && selectedTask.id === task.id ? 'true' : 'false'"
                    v-on:click="selectTask(task)">

                <span class="d-flex justify-content-between align-items-start gap-2">
                    <span>
                        <span class="d-block fw-bold text-dark">
                            <i class="fa-solid fa-ship text-secondary me-2" aria-hidden="true"></i>{{ task.nome }}
                        </span>
                        <span class="d-block text-secondary">{{ getTaskDock(task) }}</span>
                        @* La nave puo' restare in banchina oltre la mezzanotte: qui la
                           lavorazione compare anche nel giorno dopo, e va detto di chi e'. *@
                        <span v-if="task.giorno !== giornoSelezionato"
                              class="badge bg-secondary-subtle text-secondary border border-secondary-subtle mt-1">
                            <i class="fa-regular fa-calendar me-1" aria-hidden="true"></i>Lavorazione di {{ getNomeGiorno(task.giorno) }}
                        </span>
                    </span>
                    <span class="role-badge" v-bind:class="'role-' + task.competenzaRichiesta">
                        Richiede: {{ task.competenzaRichiesta }}
                    </span>
                </span>

                <span class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3 pt-3 border-top border-light text-secondary">
                    <span>
                        <i class="fa-regular fa-clock me-1 text-primary" aria-hidden="true"></i>
                        Durata: <strong>{{ fmtDurata(task.durataOre) }}</strong>
                    </span>
                    <span>
                        In banchina da <strong>{{ getNomeGiorno(task.etaGiorno) }} {{ fmtOra(task.etaOra) }}</strong>
                        a <strong>{{ getNomeGiorno(task.etdGiorno) }} {{ fmtOra(task.etdOra) }}</strong>
                    </span>
                </span>
            </button>
            </div>
        </div>

        @* --- Proposte del DSS per la lavorazione selezionata ------------------- *@
        <div v-if="selectedTask" class="mt-3 pt-3 border-top">
            <h3 class="h6 text-primary fw-bold mb-3">
                <i class="fa-solid fa-wand-magic-sparkles text-warning me-2" aria-hidden="true"></i>
                Come vuoi assegnare "{{ selectedTask.nome }}"?
            </h3>

            @* Quattro stati distinti: caricamento, problema di rete, nessuna
               alternativa, elenco delle alternative. *@
            <p v-if="caricamentoDSSTask" class="text-center text-secondary py-3 mb-0" role="status">
                <i class="fa-solid fa-spinner fa-spin text-primary me-2" aria-hidden="true"></i>
                Sto cercando le alternative possibili…
            </p>

            <div v-else-if="problemaDSS" class="avviso-connessione p-3 d-flex align-items-start gap-2" role="alert">
                <i class="fa-solid fa-plug-circle-exclamation mt-1" aria-hidden="true"></i>
                <div>
                    <strong>Non ho potuto calcolare le alternative.</strong>
                    Il server non ha risposto, quindi non posso dirti se ce ne sono.
                    <button type="button" class="btn btn-link btn-sm p-0 align-baseline"
                            v-on:click="caricaSoluzioneTaskSuggerita(selectedTask.id)">Riprova</button>
                </div>
            </div>

            <div v-else-if="soluzioniDSSTask.length === 0">
                <partial name="~/Features/PianificazioneTurni/_NessunaAlternativa.cshtml" />
            </div>

            <fieldset v-else class="border-0 p-0 m-0">
                <legend class="visually-hidden">Alternative proposte per {{ selectedTask.nome }}</legend>

                <div class="d-flex flex-column gap-2">
                    <label v-for="(sol, index) in soluzioniDSSTask" :key="index"
                           class="dss-option p-3 d-flex align-items-start gap-2"
                           v-bind:class="{ 'dss-option-selected': indiceDSSCorrente === index }">
                        <input type="radio" name="soluzioneDSS" class="form-check-input mt-1 flex-shrink-0"
                               v-bind:checked="indiceDSSCorrente === index"
                               v-on:change="soluzioneDSSSelezionataIndex = index">
                        <span class="flex-grow-1">
                            <span class="d-flex align-items-center flex-wrap gap-2 mb-1">
                                <strong class="text-dark">{{ sol.molo }} · {{ fmtOra(sol.orario) }} · {{ sol.operatore }}</strong>
                                <span v-if="sol.consigliata" class="badge bg-success">Consigliata</span>
                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">
                                    Compatibilità {{ sol.score }}%
                                </span>
                            </span>
                            <span class="d-block text-secondary">
                                {{ sol.vantaggi.join(' · ') }}<span v-if="sol.compromessi.length > 0"> — {{ sol.compromessi.join(', ') }}</span>
                            </span>
                        </span>
                    </label>

                    @* Riepilogo dell'effetto della scelta prima di applicarla. *@
                    <p v-if="soluzioneDSSCorrente" class="dss-riepilogo p-2 mb-0 mt-1 text-secondary">
                        <i class="fa-regular fa-comment-dots me-1" aria-hidden="true"></i>
                        La lavorazione sarà assegnata a
                        <strong>{{ soluzioneDSSCorrente.operatore }}</strong>
                        al <strong>{{ soluzioneDSSCorrente.molo }}</strong>,
                        <strong>{{ getNomeGiorno(soluzioneDSSCorrente.giorno) }}</strong>
                        alle <strong>{{ fmtOra(soluzioneDSSCorrente.orario) }}</strong>.
                    </p>

                    <div class="d-flex gap-2 mt-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm px-3"
                                v-on:click="selectTask(selectedTask)">
                            Lascia perdere
                        </button>
                        <button type="button" class="btn btn-primary btn-sm flex-grow-1 fw-bold"
                                v-bind:disabled="!soluzioneDSSCorrente || operazioneInCorso"
                                v-on:click="applicaSoluzioneDSSSelezionata(soluzioneDSSCorrente)">
                            <i class="fa-solid" v-bind:class="operazioneInCorso ? 'fa-spinner fa-spin' : 'fa-wand-magic-sparkles'" aria-hidden="true"></i>
                            {{ operazioneInCorso ? 'Sto assegnando…' : 'Applica questa soluzione' }}
                        </button>
                    </div>
                </div>
            </fieldset>
        </div>
    </div>
</section>
