@* Il tabellone: una riga per banchina, le 24 ore in orizzontale. *@

<div class="p-2 mb-3 rounded shadow-sm" style="border: 1px solid var(--color-border); background-color: var(--color-surface);">
    <div class="d-flex gap-2 overflow-x-auto" role="group" aria-label="Scegli il giorno da visualizzare">
        <button v-for="g in giorniSettimana" :key="g.index"
                type="button" class="btn calendar-btn"
                v-bind:aria-current="giornoSelezionato === g.index ? 'date' : false"
                v-on:click="selezionaGiorno(g.index)">
            <span class="calendar-day">{{ g.nome }}</span>
            <span class="calendar-date">{{ g.dataStr }}</span>
        </button>
    </div>
</div>

<p v-if="selectedTask" class="d-flex align-items-center gap-2 px-3 py-2 mb-2 rounded"
   style="background-color: var(--color-primary-light); border: 1px solid var(--color-primary);">
    <i class="fa-solid fa-crosshairs text-primary" aria-hidden="true"></i>
    <span><strong>Lavorazione attiva:</strong> {{ selectedTask.nome }} · richiede {{ selectedTask.competenzaRichiesta }}</span>
</p>

<section class="gantt-container flex-grow-1 d-flex flex-column" aria-labelledby="titolo-gantt">
    <h2 id="titolo-gantt" class="visually-hidden">
        Tabellone dei turni per {{ getNomeGiorno(giornoSelezionato) }}
    </h2>

    <div class="gantt-hour-row border-bottom flex-shrink-0 d-flex">
        <div class="fw-bold text-secondary d-flex align-items-center px-3"
             style="width: 140px; min-width: 140px; flex-shrink: 0; font-size: var(--fs-xs);">
            Banchine
        </div>
        <div class="gantt-hour-row-track position-relative flex-grow-1">
            <span v-for="h in oreTimeline" :key="h" class="gantt-hour-tick text-secondary"
                  style="font-size: var(--fs-xs); font-weight: 600;"
                  v-bind:style="{ left: tickLeft(h) }">{{ fmtTick(h) }}</span>
        </div>
    </div>

    <div class="gantt-body flex-grow-1 overflow-y-auto custom-scrollbar">
        <div v-for="b in banchine" :key="b"
             class="gantt-row border-bottom position-relative d-flex align-items-center"
             style="min-height: 52px;">

            <div class="gantt-row-label px-3 d-flex align-items-center"
                 style="width: 140px; min-width: 140px; height: 100%; flex-shrink: 0; border-right: 1px solid var(--color-border);">
                <span class="fw-bold text-dark" style="font-size: var(--fs-xs);">{{ b }}</span>
            </div>

            <div class="gantt-row-track position-relative flex-grow-1" style="height: 100%;">
                <div v-for="h in oreTimeline" :key="'linea' + h" class="gantt-vline"
                     v-bind:style="{ left: tickLeft(h) }" aria-hidden="true"></div>

                @* Finestra di attracco della nave selezionata. *@
                <div v-if="isTaskSelezionatoVisibileOggi()" class="gantt-task-window"
                     v-bind:style="{ left: getTaskWindowLeft(), width: getTaskWindowWidth() }"
                     aria-hidden="true"></div>

                @* Slot suggerito: compare quando un operatore compatibile è sotto il
                   mouse o ha il focus. *@
                <button v-if="slotFantasma && slotFantasma.banchina === b"
                        type="button"
                        class="gantt-block gantt-block-fantasma"
                        v-bind:style="{
                            left: blockLeft({ startOra: slotFantasma.orario, giorno: giornoSelezionato, isDelayed: false, ritardoOre: 0 }),
                            width: blockWidth({ durataOre: selectedTask.durataOre })
                        }"
                        v-on:click.stop="assegnaSlotFantasma()">
                    <span class="gantt-block-title fw-bold">
                        <i class="fa-regular fa-hand-pointer me-1" aria-hidden="true"></i>Slot libero
                    </span>
                    <span class="visually-hidden">
                        Assegna {{ selectedTask.nome }} a {{ slotFantasma.operatoreNome }} al {{ b }} alle {{ fmtOra(slotFantasma.orario) }}
                    </span>
                </button>

                @* Turni assegnati: descrizioneTurno() include anche lo stato, così il
                   conflitto non resta affidato al solo colore. *@
                <button v-for="t in getTurniPerBanchina(b)" :key="t.id"
                        type="button"
                        class="gantt-block d-flex flex-column justify-content-center"
                        v-bind:class="[getBlockClass(t), {
                            'gantt-block-evidenziato': operatoreInAnteprima && t.operatore === operatoreInAnteprima,
                            'gantt-block-bloccante': mostraBloccanti && turniCheBloccano.indexOf(t.id) !== -1
                        }]"
                        v-bind:style="{
                            left: blockLeft(t),
                            width: blockWidth(t),
                            opacity: isElementoFiltrato(t) ? 1 : 0.25
                        }"
                        v-bind:title="descrizioneTurno(t)"
                        v-bind:aria-label="descrizioneTurno(t)"
                        v-on:click.stop="handleBlockClick(t)">
                    <span class="gantt-block-title fw-bold text-truncate">
                        {{ t.nome }}
                    </span>
                    <span class="gantt-block-sub text-truncate">
                        <i class="fa-solid fa-user me-1" aria-hidden="true"></i>{{ t.operatore }}
                        <span v-if="statoTurno(t) !== 'regolare'" class="gantt-block-stato ms-1">
                            <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
                            {{ statoTurno(t) === 'ritardo' ? '+' + fmtDurata(t.ritardoOre) : etichettaStatoTurno(t) }}
                        </span>
                    </span>
                </button>
            </div>
        </div>
    </div>
</section>

@* Stesso contenuto del tabellone in forma di elenco, percorribile in sequenza. *@
<details class="mt-3">
    <summary class="text-secondary" style="cursor: pointer; font-size: var(--fs-sm);">
        Elenco testuale dei turni di {{ getNomeGiorno(giornoSelezionato) }}
    </summary>
    <ul class="list-unstyled mt-2 mb-0">
        <li v-for="t in getTurniDelGiorno()" :key="'elenco' + t.id" class="py-1 border-bottom border-light">
            {{ descrizioneTurno(t) }}
        </li>
        <li v-if="getTurniDelGiorno().length === 0" class="text-muted py-1">
            Nessun turno assegnato in questo giorno.
        </li>
    </ul>
</details>
